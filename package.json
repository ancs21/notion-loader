{
  "name": "notion-loader",
  "version": "0.1.0",
  "description": "Astro Content Loader for Notion as a CMS. Fork of astro-notion/notion-astro-loader with Astro 6 compatibility patches.",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./schemas": {
      "types": "./dist/schemas/index.d.ts",
      "import": "./dist/schemas/index.js"
    },
    "./schemas/raw-properties": {
      "types": "./dist/schemas/raw-properties.d.ts",
      "import": "./dist/schemas/raw-properties.js"
    },
    "./schemas/transformed-properties": {
      "types": "./dist/schemas/transformed-properties.d.ts",
      "import": "./dist/schemas/transformed-properties.js"
    },
    "./schemas/page": {
      "types": "./dist/schemas/page.d.ts",
      "import": "./dist/schemas/page.js"
    }
  },
  "files": ["dist"],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "prepublishOnly": "npm run build"
  },
  "keywords": [
    "astro",
    "astro-loader",
    "astro-integration",
    "notion",
    "cms",
    "content-loader"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/ancs21/notion-loader.git"
  },
  "license": "MIT",
  "dependencies": {
    "@jsdevtools/rehype-toc": "^3.0.2",
    "@notionhq/client": "^4.0.0",
    "fs-extra": "^11.3.5",
    "kleur": "^4.1.5",
    "notion-rehype-k": "^1.1.6",
    "rehype-slug": "^6.0.0",
    "rehype-stringify": "^10.0.1",
    "slug": "^11.0.1",
    "unified": "^11.0.5",
    "unist-util-visit": "^5.1.0",
    "vfile": "^6.0.3"
  },
  "devDependencies": {
    "@types/fs-extra": "^11.0.4",
    "@types/slug": "^5.0.9",
    "astro": "^6.3.0",
    "typescript": "^5.6.3",
    "zod": "^4.0.0"
  },
  "peerDependencies": {
    "astro": ">=6.0.0",
    "zod": ">=4.0.0"
  }
}
